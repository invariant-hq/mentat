; bench_poll_scaling is not a thumper suite: it is a boolean scaling gate over
; the incremental projector [Feed.next] indexes, asserting one commit's advance
; is flat across session sizes (see its header). It gates on @bench by exit
; code, on allocation — exact and machine-independent — so it never flakes.

(executable
 (name bench_poll_scaling)
 (modules bench_poll_scaling)
 (libraries
  mentat_protocol
  mentat_session
  mentat_llm
  mentat_mutation
  bench_support))

; bench_engine_latency drives the real engine over a real temp-dir store to
; time submit -> first streamed token across session sizes. It is a wall TREND
; (never gated): engine orchestration is multi-fiber and stateful per turn, so
; it is a direct driver — fresh session per sample, first samples discarded —
; not a thumper suite, and it lives on @bench, printing to the nightly log. The
; gate-worthy scaling property is bench_poll_scaling's, deterministically.

(executable
 (name bench_engine_latency)
 (modules bench_engine_latency)
 (libraries
  mentat_agent
  mentat_broker
  mentat_client
  mentat_protocol
  mentat_session
  mentat_store
  mentat_mutation
  mentat_llm
  mentat_sandbox
  mentat_permission
  mentat_diagnostic
  mentat_edit
  mentat_digest
  lpath
  eio
  eio_main
  mtime
  mtime.clock.os
  unix
  bench_support))

; Tier A gate: each suite checked against its committed baseline on @bench.
; One rule per suite (not a shared progn) so every suite runs even when another
; regresses or needs a first baseline, and all promotions surface together.
;
; These gates are NOT on runtest, because a thumper baseline file is partitioned
; by machine: it holds one section per host key, and a suite checks against its
; own host's section. A committed baseline therefore says nothing about a host
; that has not blessed one, so on any new machine the gate reports a missing
; baseline rather than a regression. That is a correct answer to the question
; thumper is asked, and a useless one for `dune runtest`, which every checkout
; must be able to pass. Allocation is machine-independent in value; the lookup
; that finds a number to compare it against is not.

(rule
 (alias bench)
 (locks /bench)
 (action
  (progn
   (run %{exe:bench_path.exe} --quick)
   (diff? path.thumper path.thumper.corrected))))

(rule
 (alias bench)
 (locks /bench)
 (action
  (progn
   (run %{exe:bench_digest.exe} --quick)
   (diff? digest.thumper digest.thumper.corrected))))

(rule
 (alias bench)
 (locks /bench)
 (action
  (progn
   (run %{exe:bench_diff.exe} --quick)
   (diff? diff.thumper diff.thumper.corrected))))

(rule
 (alias bench)
 (locks /bench)
 (action
  (progn
   (run %{exe:bench_resume.exe} --quick)
   (diff? resume.thumper resume.thumper.corrected))))

(rule
 (alias bench)
 (locks /bench)
 (action
  (progn
   (run %{exe:bench_session_list.exe} --quick)
   (diff? session_list.thumper session_list.thumper.corrected))))

(rule
 (alias bench)
 (locks /bench)
 (action
  (progn
   (run %{exe:bench_mutation.exe} --quick)
   (diff? mutation.thumper mutation.thumper.corrected))))

(rule
 (alias bench)
 (locks /bench)
 (action
  (progn
   (run %{exe:bench_revert.exe} --quick)
   (diff? revert.thumper revert.thumper.corrected))))

(rule
 (alias bench)
 (locks /bench)
 (action
  (progn
   (run %{exe:bench_enter.exe} --quick)
   (diff? enter.thumper enter.thumper.corrected))))

(rule
 (alias bench)
 (locks /bench)
 (action
  (progn
   (run %{exe:bench_transcript.exe} --quick)
   (diff? transcript.thumper transcript.thumper.corrected))))

; The poll scaling gate: a boolean flat-across-sizes assertion, not a baseline
; comparison, so it runs directly and fails runtest on a nonzero exit. It stays
; on runtest precisely because it holds no baseline — it asserts a property of
; the projector rather than comparing against a recorded number, so it answers
; the same on every host.

(rule
 (alias bench)
 (action
  (run %{exe:bench_poll_scaling.exe})))
