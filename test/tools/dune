(library
 (name test_tools_dependency_laws)
 (modules test_tools_dependency_laws)
 ; Law L1 sweeps every source under lib and bin, and the exact-pin laws read one
 ; dune file each, so the whole lib and bin trees are materialised as deps. A
 ; single source_tree per top directory subsumes the per-library dune deps the
 ; older per-boundary laws named. otherlibs carries the standalone law's members.
 (inline_tests
  (deps
   (source_tree ../../lib)
   (source_tree ../../bin)
   (source_tree ../../otherlibs)))
 (libraries compiler-libs.common windtrap unix)
 (preprocess
  (pps ppx_windtrap)))
