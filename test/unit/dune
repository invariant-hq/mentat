; mentatd's resident-service surface lives in bin/mentatd as the module
; service; its source is copied in like reconcile's, and only the pure half
; (rendering, paths, standing) is driven — the effectful verbs need a service
; manager. The copy compiles whole, so the stanza links mentat_boot under the
; executable's own -open, as test_routine_fire does.

(copy_files
 (files ../../bin/mentatd/service.{ml,mli}))

(test
 (name test_service)
 (modules test_service service)
 (flags
  (:standard -open Mentat_boot))
 (libraries windtrap mentat_boot unix))

; The resident routine node lives in bin/mentatd as the module node; its
; source is copied in like service's, and only the pure folds (ingress
; resolution, the delivery route, the child-environment scrub) are driven —
; the effectful surfaces need a daemon behind them. The copy compiles whole,
; so the stanza links the node's libraries under the executable's own -open.

(copy_files
 (files ../../bin/mentatd/node.{ml,mli}))

(test
 (name test_node)
 (modules test_node node)
 (flags
  (:standard -open Mentat_boot))
 (libraries
  windtrap
  mentat_boot
  mentat_broker
  mentat_routine
  mentat_github
  mentat_provider_runtime
  mentat_server
  eio
  unix))

; The node's routine reconcile drivers live in bin/mentatd as the module
; routine_reconcile; its source is copied in like reconcile's and the
; drivers are exercised over a temporary routine estate (the pure tables
; they interpret live in mentat_routine and are tested with that library).
; The copy compiles whole, so the stanza links the drivers' libraries under
; the executable's own -open.

(copy_files
 (files ../../bin/mentatd/routine_reconcile.{ml,mli}))

