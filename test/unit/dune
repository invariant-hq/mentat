; The review-git projection lives in bin/boot (executable-side adapter, RFC
; 0009); its source is copied in so its pure closure-injected unit tests keep
; running as a fast unit suite without linking the boot library's engine
; closure.

(copy_files
 (files ../../bin/boot/review_git.{ml,mli}))

(test
 (name test_review_git)
 (modules test_review_git review_git)
 (libraries
  windtrap
  textdiff
  mentat_digest
  lpath
  mentat_review
  mentat_workspace))

; The user-directory path policy lives in bin/boot (executable-side); its
; derivations are pure functions, so its source is copied in and the suite
; runs without linking the boot library. The child-socket leaf rule it binds
; to the per-user base lives in mentat_broker.

(copy_files
 (files ../../bin/boot/user_dirs.{ml,mli}))

(test
 (name test_user_dirs)
 (modules test_user_dirs user_dirs)
 (libraries windtrap mentat_broker mentat_digest unix))

; The executable-side filesystem primitives live in bin/boot; the source is
; copied in and the suite runs without linking the boot library. The append
; tests run under Eio_main — append serializes in-process callers on a
; per-path Eio.Mutex, so it must run inside a fiber.

(copy_files
 (files ../../bin/boot/fs.{ml,mli}))

(test
 (name test_fs)
 (modules test_fs fs)
 (libraries windtrap eio eio.unix eio_main unix))

