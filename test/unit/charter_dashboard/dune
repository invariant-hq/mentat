; Unit suite for the daemon's charters dashboard (bin/mentatd). Its source
; compiles against [Charter_reconcile], whose flat-directory copy is already
; owned by the test_charter_reconcile stanza one level up, so this suite
; lives in its own directory with its own copies. Only the pure projection
; is driven — the observation needs a daemon estate behind it, which the
; web blackbox family exercises end to end.

(copy_files
 (files ../../../bin/mentatd/charter_dashboard.{ml,mli}))

(copy_files
 (files ../../../bin/mentatd/charter_reconcile.{ml,mli}))

(test
 (name test_charter_dashboard)
 (modules test_charter_dashboard charter_dashboard charter_reconcile)
 (flags
  (:standard -open Mentat_boot))
 (libraries
